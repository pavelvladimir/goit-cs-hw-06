# Host port only; the HTTP server inside the container always uses 3000.
APP_PORT=3000
LOG_LEVEL=INFO
# 1..30 seconds; total MongoDB operation budget.
DB_CONNECT_TIMEOUT=2
# 16..120 seconds, at least DB_CONNECT_TIMEOUT + 13.
SHUTDOWN_GRACE_SECONDS=20
# Active handlers per process; reject excess connections before starting threads.
HTTP_MAX_CONNECTIONS=32
TCP_MAX_CONNECTIONS=32
# Absolute budget for the complete incoming HTTP request or TCP frame, 1..5 seconds.
RECEIVE_TIMEOUT=5
# Local Python execution; Compose supplies its own /run/secrets path.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_DATABASE=messages
MONGO_USER=messages_app
MONGO_PASSWORD_FILE=./secrets/mongo_password
